<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="teachers.master.cs" Inherits="AMS.teachers" %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teachers Dashboard</title>
    <link rel="stylesheet" href="css/admindashboard.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">  
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!-- Ensure this is here --> 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <img src="images/teacherslogo.png" alt="Admin Logo" class="adminlogo">
        <button class="toggle-btn" onclick="toggleSidebar()"><i class="fas fa-chevron-circle-left"></i></button>
    </div>
    <ul>
     <li><a href="teachersemesterlist.aspx"><i class="fas fa-list"></i> Semester Lists</a></li>
        <li><a href="teachertimetable.aspx"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
        <li><a href="teacherinbox.aspx"><i class="fas fa-envelope"></i> Inbox</a></li>
           <li><a href="teachersprofile.aspx"><i class="fas fa-user"></i> Profile</a></li>
            <li><a href="#" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
</div>

<div class="content">
    <nav id="navbar-example2" class="navbar navbar-light bg-transparent">
        <div class="date-time" id="dateTime"></div>
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link" href="#fat"><i class="fas fa-bell"></i></a>
            </li>
            <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-user">&nbsp;</i><asp:Literal ID="litUsername" runat="server" /></a>
            <ul class="dropdown-menu dropdown-menu-left"> <!-- Add the custom class here -->
                <li><a class="dropdown-item" href="teachersreport.aspx"><i class="fas fa-file-alt"></i> Report</a></li>
                <li><a class="dropdown-item" href="teachersetting.aspx"><i class="fas fa-cog"></i> Setting</a></li>
            </ul>
        </li>

        </ul>
    </nav>
    <form id="form1" runat="server">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </form>
</div>

<div id="spinner" class="spinner">
    <img src="images/spinner.gif" alt="Loading...">
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script>
    function updateDateTime() {
        var now = new Date();
        var hours = now.getHours();
        var minutes = now.getMinutes();
        var day = now.toLocaleString('en-us', { weekday: 'short' });
        var date = now.getDate();
        var month = now.toLocaleString('en-us', { month: 'short' });
        var year = now.getFullYear().toString().slice(2);

        // Add leading zero to minutes if needed
        if (minutes < 10) minutes = '0' + minutes;

        var formattedDate = `${hours}:${minutes} ${day},${date} ${month} ${year}`;

        document.getElementById('dateTime').textContent = formattedDate;
    }

    // Update the date and time every minute
    setInterval(updateDateTime, 60000);

    // Initial call to set the date and time immediately
    updateDateTime();

    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('hidden');
    }

    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector(".sidebar");
        const content = document.querySelector(".content");

        // Hide sidebar initially if screen width is less than 768px
        if (window.innerWidth < 768) {
            sidebar.classList.add("hidden");
        }

        // Adjust content shift based on sidebar visibility
        sidebar.addEventListener("transitionend", function () {
            content.classList.toggle("shift", sidebar.classList.contains("hidden"));
        });

        // Adjust content shift based on window resize
        window.addEventListener("resize", function () {
            if (window.innerWidth < 768) {
                sidebar.classList.add("hidden");
            } else {
                sidebar.classList.remove("hidden");
            }
        });
    });

    document.onreadystatechange = function () {
        if (document.readyState !== "complete") {
            document.querySelector("#spinner").style.display = "flex";
        } else {
            setTimeout(function () {
                document.querySelector("#spinner").style.display = "none";
            }, 600); // Adjust the delay time as needed (1000ms = 1 second)
        }
    };
    function logout() {
        Swal.fire({
            icon: 'success',
            title: 'Logged out!',
            text: 'You have successfully logged out.',
            showConfirmButton: false,
            timer: 2000
        }).then(() => {
            document.forms[0].action = 'index.aspx'; // Proceed with the form submission
            document.forms[0].submit();
        });
    }

</script>
</body>
</html>
