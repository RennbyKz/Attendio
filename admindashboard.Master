<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="admindashboard.master.cs" Inherits="AMS.admindashboard" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="icon" type="image/png" href="images/UcspLogo1.png" />  
    <link rel="stylesheet" href="css/admindashboard.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <img src="images/adminlogo.png" alt="Admin Logo" class="adminlogo">
        <button class="toggle-btn" onclick="toggleSidebar()"><i class="fas fa-chevron-circle-left"></i></button>
    </div>
    <ul>
        <li><a href="Dashboard.aspx"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
        <li><a href="ManageStudents.aspx"><i class="fas fa-users"></i> Manage Students</a></li>
        <li><a href="ManageTeachers.aspx"><i class="fas fa-chalkboard-teacher"></i> Manage Teachers</a></li>
        <li><a href="AttendanceReports.aspx"><i class="fas fa-clipboard-list"></i> Attendance Reports</a></li>
        <li><a href="MonthlyReports.aspx"><i class="fas fa-calendar-alt"></i> Monthly Reports</a></li>
        <li><a href="UsersManage.aspx"><i class="fas fa-user-cog"></i> Users Management</a></li>
        <li><a href="ManageEntities.aspx"><i class="fas fa-database"></i> Manage Entities</a></li>
        <li><a href="AssignTeachers.aspx"><i class="fas fa-chalkboard-teacher"></i> Assign Teachers</a></li>
        <li><a href="#" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
</div>

<div class="content">
    <nav id="navbar-example2" class="navbar navbar-light bg-transparent">
        <div class="date-time" id="dateTime"></div>
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link" href="admin_inbox.aspx"><i class="fas fa-inbox"></i><asp:Literal ID="litInboxCount" runat="server" /></a>
            </li>
            <li class="nav-item">
                <a class="nav-link"  href="#" role="button"><i class="fas fa-user"></i>&nbsp;<asp:Literal ID="litUsername" runat="server" /></a>
            </li>
        </ul>
    </nav>
    <form id="form1" runat="server">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </form>
</div>

<div id="spinner" class="spinner">
    <img src="images/spinner.gif" alt="Loading...">
</div>

<script src="js/bootstrap.bundle.min.js"></script>
<script src="js/sweetalert2@11.js"></script>
<script>
    function updateDateTime() {
        var now = new Date();
        var hours = now.getHours();
        var minutes = now.getMinutes();
        var day = now.toLocaleString('en-us', { weekday: 'short' });
        var date = now.getDate();
        var month = now.toLocaleString('en-us', { month: 'short' });
        var year = now.getFullYear().toString().slice(2);

        // Add leading zero to minutes if needed
        if (minutes < 10) minutes = '0' + minutes;

        var formattedDate = `${hours}:${minutes} ${day},${date} ${month} ${year}`;

        document.getElementById('dateTime').textContent = formattedDate;
    }

    // Update the date and time every minute
    setInterval(updateDateTime, 60000);

    // Initial call to set the date and time immediately
    updateDateTime();

    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('hidden');
    }

    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector(".sidebar");
        const content = document.querySelector(".content");

        // Hide sidebar initially if screen width is less than 768px
        if (window.innerWidth < 768) {
            sidebar.classList.add("hidden");
        }

        // Adjust content shift based on sidebar visibility
        sidebar.addEventListener("transitionend", function () {
            content.classList.toggle("shift", sidebar.classList.contains("hidden"));
        });

        // Adjust content shift based on window resize
        window.addEventListener("resize", function () {
            if (window.innerWidth < 768) {
                sidebar.classList.add("hidden");
            } else {
                sidebar.classList.remove("hidden");
            }
        });
    });

    document.onreadystatechange = function () {
        if (document.readyState !== "complete") {
            document.querySelector("#spinner").style.display = "flex";
        } else {
            setTimeout(function () {
                document.querySelector("#spinner").style.display = "none";
            }, 600); // Adjust the delay time as needed (1000ms = 1 second)
        }
    };
    function logout() {
        Swal.fire({
            icon: 'success',
            title: 'Logged out!',
            text: 'You have successfully logged out.',
            showConfirmButton: false,
            timer: 2000
        }).then(() => {
            document.forms[0].action = 'index.aspx'; // Proceed with the form submission
            document.forms[0].submit();
        });
    }
</script>
</body>
</html>